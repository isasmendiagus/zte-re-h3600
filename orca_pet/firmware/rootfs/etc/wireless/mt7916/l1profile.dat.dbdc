INDEX0_main_ifname=wlan0;wlan5g0
INDEX0_ext_ifname=wlan;wlan5g
INDEX0_wds_ifname=wds;wdsx
INDEX0_apcli_ifname=apcli;apcli5g
INDEX0_mesh_ifname=mesh;meshx
INDEX0_nvram_zone=dev1;dev2
