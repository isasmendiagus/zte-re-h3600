# wpa_supplicant STA config — STAGE 2 re-verify against the owner's home AP.
# TEMPLATE: @WIFI_PSK@ is substituted by scripts/gen_wifi_configs.sh from the
# git-ignored secret scratchpad/.wifi_psk. NEVER put the passphrase here.
#
# Target: SSID "Dino-WiFi-5GHz" (exact string confirmed 2026-07-04), 5 GHz band.
# On the H3600 the 5 GHz radio is wlan1 (wlan0 = 2.4 GHz):
#   wpa_supplicant -D nl80211 -i wlan1 -c /etc/wpa_supplicant.conf
#
# Kernel cmdline REQUIREMENT (front of bootargs, ZTE U-Boot corrupts the last
# arg): pci=nomsi pcie_aspm=off   — MSI does not deliver MT7915 IRQs on this SoC.

ctrl_interface=/var/run/wpa_supplicant
update_config=0

network={
    ssid="Dino-WiFi-5GHz"
    scan_ssid=1
    key_mgmt=WPA-PSK
    proto=RSN
    pairwise=CCMP
    group=CCMP
    ieee80211w=1
    psk="@WIFI_PSK@"
}
