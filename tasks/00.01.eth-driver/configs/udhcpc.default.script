#!/bin/sh
# busybox udhcpc default.script — minimal, uses busybox `ip`. [Phase 1.2]
RESOLV=/etc/resolv.conf
case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ip link set "$interface" up
    ;;
  renew|bound)
    ip addr flush dev "$interface" 2>/dev/null
    ip addr add "$ip/${mask:-24}" dev "$interface"
    ip link set "$interface" up
    if [ -n "$router" ]; then
      ip route del default 2>/dev/null
      for r in $router; do ip route add default via "$r" dev "$interface"; done
    fi
    : > "$RESOLV" 2>/dev/null
    [ -n "$domain" ] && echo "search $domain" >> "$RESOLV"
    for d in $dns; do echo "nameserver $d" >> "$RESOLV"; done
    echo "udhcpc: $interface bound $ip (gw=${router:-none} dns=${dns:-none})"
    ;;
  leasefail|nak)
    echo "udhcpc: $interface lease $1"
    ;;
esac
exit 0
