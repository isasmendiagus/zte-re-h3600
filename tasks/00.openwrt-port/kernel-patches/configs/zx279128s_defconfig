# Minimal defconfig for ZTE ZX279128S H3600 first boot
# Goal: kernel boots, prints via PL011 UART, exec /bin/sh from rootfs
#
# ┌────────────────────────────────────────────────────────────────────┐
# │ Note (2026-05-23): Two zx279128s_defconfig files exist in zxic:    │
# │                                                                    │
# │   1. THIS FILE (71 lines) — the MINIMAL "first-boot" seed used by  │
# │      the OpenWrt-port build pipeline (build_kernel.sh).            │
# │      Represents the aspirational "smallest set of CONFIG_* needed  │
# │      to bring up the SoC + emit kernel printk on PL011".           │
# │                                                                    │
# │   2. linux-v6.6/arch/arm/configs/zx279128s_defconfig (1300 lines)  │
# │      — the FULL ACTIVE config we use for current driver dev.       │
# │      Generated via `make savedefconfig` from the working build.    │
# │                                                                    │
# │ Active driver iter loop uses #2 (richer; includes everything the   │
# │ eth driver needs). OpenWrt port (stage 5/6) starts from #1 as a    │
# │ smaller, auditable base, then layers OpenWrt's needs on top.       │
# │                                                                    │
# │ Keep them aware of each other when editing either.                 │
# └────────────────────────────────────────────────────────────────────┘
#
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EMBEDDED=y
CONFIG_PROFILING=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ZX=y
CONFIG_SOC_ZX279128S=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGHMEM=y
CONFIG_HZ_100=y
CONFIG_AEABI=y
CONFIG_HIGHPTE=y
CONFIG_CMA=y
CONFIG_ZBOOT_ROM_TEXT=0x0
CONFIG_ZBOOT_ROM_BSS=0x0
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="console=ttyAMA0,115200n8 earlyprintk init=/bin/sh"
CONFIG_KEXEC=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_PM=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_DENALI_DT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_NETDEVICES=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# CONFIG_HW_RANDOM is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
# CONFIG_HWMON is not set
# CONFIG_USB is not set
# CONFIG_SOUND is not set
# CONFIG_NEW_LEDS is not set
CONFIG_RTC_CLASS=y
# CONFIG_DMA_ENGINE is not set
CONFIG_COMMON_CLK=y
CONFIG_EXT4_FS=y
CONFIG_JFFS2_FS=y
CONFIG_TMPFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_LL=y
CONFIG_EARLY_PRINTK=y
