# ZTE ZXIC ZX279128S ethernet driver
#

config NET_VENDOR_ZTE
	bool "ZTE devices"
	default y
	depends on OF || COMPILE_TEST
	help
	  If you have a network (Ethernet) card belonging to this family of
	  ZTE/ZXIC SoCs, say Y here.

	  Note that the answer to this question doesn't directly affect the
	  kernel: saying N will just cause the configurator to skip all the
	  questions about ZTE devices. If you say Y, you will be asked for
	  your specific card in the following questions.

if NET_VENDOR_ZTE

config ZX279128_ETH
	tristate "ZTE ZX279128S Ethernet (idm0/idm1)"
	depends on ARCH_ZX || COMPILE_TEST
	depends on OF
	select PHYLIB
	help
	  This driver supports the integrated ethernet block of ZTE's ZXIC
	  ZX279128S SoC. It exposes two netdevs (idm0 / idm1) driven by an
	  on-chip NPP/IDM packet processor. Four GePHYs sit on an internal
	  MDIO bus and connect to RJ45 ports via a hardware switch.

	  To compile this driver as a module, choose M here. The module will
	  be called zx279128-eth.

endif # NET_VENDOR_ZTE
